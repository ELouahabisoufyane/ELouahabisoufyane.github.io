---
import { site } from "../data/site";
import { localize } from "../i18n";
const { lang, t, href, frenchPath, englishPath } = localize(Astro.url);
const links = [
  { path: "/", label: t("Accueil", "Home") },
  { path: "/a-propos/", label: t("À propos", "About us") },
  { path: "/audit-energetique/", label: t("Audit énergétique", "Energy audit") },
  { path: "/renovation-energetique/", label: t("Rénovation", "Renovation") },
  { path: "/amo-copropriete/", label: t("Copropriété", "Condominiums") },
];
const isActive = (path: string) => frenchPath === path;
---
<div class="bg-nuit text-white">
  <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-2 px-5 py-2 text-xs sm:text-sm">
    <p>{t("Votre projet énergétique, accompagné en Alsace", "Energy renovation support across Alsace")}</p>
    <a class="font-semibold text-soleil hover:underline" href={`tel:${site.phoneHref}`}>{site.phone}</a>
  </div>
</div>
<header class="site-header">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-4">
    <a href={href("/")} class="flex min-w-0 items-center gap-2 font-display text-[13px] font-bold tracking-tight text-nuit sm:gap-3 sm:text-xl">
      <img src="/favicon.svg" width="48" height="48" alt="" class="h-8 w-8 shrink-0 sm:h-12 sm:w-12" />
      <span class="max-w-[90px] sm:max-w-none">{site.name}<span class="mt-0.5 hidden font-sans text-[10px] font-medium tracking-widest text-brume uppercase sm:block">{t("Étudier. Rénover. Mieux vivre.", "Assess. Renovate. Live better.")}</span></span>
    </a>
    <nav aria-label={t("Navigation principale", "Main navigation")} class="hidden items-center gap-5 xl:flex">
      {links.map((link) => (
        <a href={href(link.path)} aria-current={isActive(link.path) ? "page" : undefined}
          class:list={["text-sm font-semibold transition-colors hover:text-magenta", isActive(link.path) ? "text-magenta" : "text-nuit"]}>{link.label}</a>
      ))}
    </nav>
    <div class="flex shrink-0 items-center gap-2 sm:gap-3">
      <nav class="language-switch" aria-label={t("Choisir la langue", "Choose language")}>
        <a href={frenchPath} lang="fr" hreflang="fr" aria-label="Français" aria-current={lang === "fr" ? "page" : undefined}>FR</a>
        <a href={englishPath} lang="en" hreflang="en" aria-label="English" aria-current={lang === "en" ? "page" : undefined}>EN</a>
      </nav>
      <a href={href("/contact/")} class="btn-chaud hidden whitespace-nowrap text-sm lg:inline-flex">{t("Parlons de votre projet", "Let's discuss your project")} <span aria-hidden="true">↗</span></a>
      <details class="relative xl:hidden">
        <summary class="cursor-pointer rounded-xl border border-nuit/20 px-3 py-2 text-sm font-semibold">{t("Menu", "Menu")}</summary>
        <nav aria-label={t("Navigation mobile", "Mobile navigation")} class="absolute right-0 z-30 mt-3 flex w-64 flex-col gap-4 rounded-2xl border border-nuit/10 bg-white p-5 shadow-xl">
          {links.map((link) => <a href={href(link.path)} aria-current={isActive(link.path) ? "page" : undefined} class:list={["font-medium hover:text-magenta", isActive(link.path) && "text-magenta"]}>{link.label}</a>)}
          <a href={href("/contact/")} class="btn-chaud text-center">{t("Devis gratuit", "Free quote")}</a>
        </nav>
      </details>
    </div>
  </div>
</header>
