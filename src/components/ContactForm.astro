---
import { localize } from "../i18n";
interface Props { projet?: string }
const { projet = "" } = Astro.props;
const { lang, t, href } = localize(Astro.url);
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT?.trim();
const configured = !!endpoint && /^https:\/\/[^/]+\/.+/.test(endpoint) && !endpoint.includes("VOTRE_ID");
const projets = [
  t("Audit énergétique", "Energy audit"),
  t("Rénovation globale de ma maison", "Whole-home renovation"),
  t("Pompe à chaleur", "Heat pump"),
  t("Isolation par l’extérieur", "External wall insulation"),
  t("Photovoltaïque", "Solar PV"),
  t("AMO copropriété", "Condominium project support"),
  t("Autre projet", "Another project"),
];
---
{!configured && <p role="status" class="mb-6 rounded-xl border border-braise/40 bg-soleil/15 p-4 text-sm text-nuit">{t("Le formulaire est temporairement indisponible. Pour votre demande, contactez-nous par téléphone ou par e-mail.", "The form is temporarily unavailable. Please contact us by phone or email with your enquiry.")}</p>}
<form action={configured ? endpoint : undefined} method="POST" class="grid gap-5 sm:grid-cols-2" data-contact-form data-configured={configured ? "true" : "false"}>
  <input type="hidden" name="_subject" value="Nouvelle demande depuis monconseilthermique.fr" />
  <input type="hidden" name="langue" value={lang} />
  <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

  <div>
    <label for="nom" class="mb-2 block text-sm font-semibold">{t("Nom", "Name")} *</label>
    <input id="nom" name="nom" type="text" required autocomplete="name" class="champ" />
  </div>
  <div>
    <label for="telephone" class="mb-2 block text-sm font-semibold">{t("Téléphone", "Phone")} *</label>
    <input id="telephone" name="telephone" type="tel" required autocomplete="tel" class="champ" />
  </div>
  <div>
    <label for="email" class="mb-2 block text-sm font-semibold">{t("E-mail (facultatif)", "Email (optional)")}</label>
    <input id="email" name="email" type="email" autocomplete="email" class="champ" />
  </div>
  <div>
    <label for="commune" class="mb-2 block text-sm font-semibold">{t("Commune du logement", "Property town or city")}</label>
    <input id="commune" name="commune" type="text" class="champ" />
  </div>
  <div class="sm:col-span-2">
    <label for="projet" class="mb-2 block text-sm font-semibold">{t("Votre projet", "Your project")}</label>
    <select id="projet" name="projet" class="champ">
      {projets.map((p) => <option value={p} selected={p === projet}>{p}</option>)}
    </select>
  </div>
  <div class="sm:col-span-2">
    <label for="message" class="mb-2 block text-sm font-semibold">{t("Parlez-nous de votre logement", "Tell us about your property")}</label>
    <textarea id="message" name="message" rows="4" class="champ" placeholder={t("Type de logement, surface, travaux envisagés…", "Property type, floor area, planned improvements…")}></textarea>
  </div>
  <div class="sm:col-span-2">
    <label class="flex items-start gap-3">
      <input type="checkbox" name="consentement" required class="mt-1 h-5 w-5" />
      <span class="text-sm text-brume">{t("J’accepte que ces informations soient utilisées pour répondre à ma demande.", "I agree to this information being used to respond to my enquiry.")} * <a class="underline" href={href("/mentions-legales/#donnees")}>{t("En savoir plus", "Learn more")}</a></span>
    </label>
  </div>
  <div class="sm:col-span-2">
    <button type="submit" disabled={!configured} class="btn-chaud w-full cursor-pointer disabled:cursor-not-allowed disabled:opacity-50">{t("Envoyer ma demande", "Send my enquiry")} <span aria-hidden="true">↗</span></button>
    <p class="mt-3 text-xs text-brume">{t("* Champs obligatoires. Devis gratuit et sans engagement.", "* Required fields. Free, no-obligation quote.")}</p>
  </div>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>("[data-contact-form]").forEach((form) => {
    form.addEventListener("submit", (event) => {
      if (form.dataset.configured !== "true") event.preventDefault();
    });
  });
</script>
