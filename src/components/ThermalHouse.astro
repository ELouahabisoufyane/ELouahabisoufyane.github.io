---
// Illustration : maison en thermographie (chaud = toiture et fenêtres, froid = murs)
---
<svg viewBox="0 0 480 400" role="img" aria-labelledby="thermal-title" class="h-auto w-full rounded-lg">
  <title id="thermal-title">Illustration d’une maison vue en thermographie : la toiture et les fenêtres apparaissent en couleurs chaudes, les murs en couleurs froides</title>
  <defs>
    <linearGradient id="th-scale" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffc843" />
      <stop offset=".35" stop-color="#ee7a1f" />
      <stop offset=".65" stop-color="#b6366f" />
      <stop offset="1" stop-color="#4b2e83" />
    </linearGradient>
    <linearGradient id="th-wall" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#5b3a9c" />
      <stop offset="1" stop-color="#3a2670" />
    </linearGradient>
    <radialGradient id="th-heat">
      <stop offset="0" stop-color="#ffc843" stop-opacity=".95" />
      <stop offset=".5" stop-color="#ee7a1f" stop-opacity=".55" />
      <stop offset="1" stop-color="#b6366f" stop-opacity="0" />
    </radialGradient>
    <filter id="th-soft"><feGaussianBlur stdDeviation="5" /></filter>
  </defs>
  <rect width="480" height="400" fill="#100f2b" />
  <rect x="0" y="360" width="480" height="40" fill="#241a4d" />
  <!-- murs -->
  <rect x="70" y="170" width="290" height="190" fill="url(#th-wall)" />
  <!-- toiture -->
  <polygon points="48,176 215,58 382,176" fill="#b6366f" />
  <ellipse cx="215" cy="118" rx="130" ry="48" fill="url(#th-heat)" filter="url(#th-soft)" />
  <!-- fuites aux fenêtres -->
  <circle cx="140" cy="240" r="58" fill="url(#th-heat)" filter="url(#th-soft)" />
  <circle cx="290" cy="240" r="58" fill="url(#th-heat)" filter="url(#th-soft)" />
  <rect x="112" y="212" width="56" height="56" rx="3" fill="#ffc843" />
  <rect x="262" y="212" width="56" height="56" rx="3" fill="#ffc843" />
  <!-- porte -->
  <rect x="190" y="280" width="50" height="80" rx="3" fill="#8a3a8f" />
  <rect x="190" y="340" width="50" height="20" fill="url(#th-heat)" filter="url(#th-soft)" opacity=".7" />
  <!-- échelle de température -->
  <rect x="426" y="70" width="18" height="260" rx="3" fill="url(#th-scale)" />
  <text x="435" y="58" fill="#d5d7ec" font-size="13" text-anchor="middle" font-family="sans-serif">chaud</text>
  <text x="435" y="350" fill="#d5d7ec" font-size="13" text-anchor="middle" font-family="sans-serif">froid</text>
</svg>
