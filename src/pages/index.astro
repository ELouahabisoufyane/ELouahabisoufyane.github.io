---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.astro";
import ContactMethods from "../components/ContactMethods.astro";
import { site } from "../data/site";
import { services } from "../data/services";
import { zones } from "../data/zones";
import { servicesEn } from "../data/services.en";
import { localize } from "../i18n";
const { lang, t, href } = localize(Astro.url);
const localizedServices = lang === "en" ? servicesEn : services;

const diapositives = [
  { image: "/images/maison-renovee.jpg", alt: t("Maison lumineuse au cœur d’un jardin", "A bright home surrounded by a garden"), titre: t("Un logement mieux rénové", "A better-renovated home"), texte: t("Des travaux adaptés à votre maison et à votre budget.", "Improvements tailored to your home and your budget.") },
  { image: "/images/interieur-renove.jpg", alt: t("Intérieur rénové et baigné de lumière", "A renovated, light-filled interior"), titre: t("Plus de confort au quotidien", "More everyday comfort"), texte: t("Un intérieur agréable en toute saison, avec moins de pertes de chaleur.", "A comfortable interior in every season, with less heat loss.") },
  { image: "/images/confort-thermique.jpg", alt: t("Pièce de vie chaleureuse dans une maison", "A welcoming living space in a home"), titre: t("Des économies bien pensées", "Smarter energy savings"), texte: t("Les bons travaux, dans le bon ordre, avec les aides adaptées.", "The right improvements, in the right order, with suitable funding.") },
];
const etapes = [
  { titre: t("Vous nous contactez", "Get in touch"), texte: t("Vous décrivez votre projet par téléphone ou avec le formulaire.", "Tell us about your project by phone or using the form.") },
  { titre: t("Visite du logement", "Property visit"), texte: t("Nous relevons le bâti, la ventilation et le chauffage sur place.", "We assess the building, ventilation and heating on site.") },
  { titre: t("Rapport et scénarios", "Report and options"), texte: t("Vous recevez des programmes de travaux chiffrés, classés par efficacité.", "You receive costed renovation plans ranked by effectiveness.") },
  { titre: t("Aides et devis", "Funding and quotes"), texte: t("Nous vous accompagnons sur les aides et la comparaison des devis.", "We help you explore funding and compare contractor quotes.") },
];
---
<Layout
  title={t("Audit énergétique et rénovation énergétique en Alsace", "Energy audits and home renovation in Alsace")}
  description={t("Audit énergétique et rénovation énergétique en Alsace : réduisez vos factures et gagnez en confort avec un accompagnement personnalisé et des aides optimisées. Devis gratuit sous 24 h.", "Energy audits and renovation in Alsace: lower your bills and improve comfort with personalised advice and suitable funding. Free quote within 24 hours.")}
>
  <section class="hero-home bg-nuit text-white">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-16 lg:grid-cols-2 lg:py-24">
      <div>
        <p class="mb-5 text-xs font-semibold tracking-widest text-soleil uppercase">{t("Conseil thermique · Strasbourg & Alsace", "Energy consultancy · Strasbourg & Alsace")}</p>
        <h1 class="text-4xl font-bold leading-tight sm:text-5xl lg:text-6xl">{t("Moins de dépenses. Plus de confort.", "Lower bills. Greater comfort.")}</h1>
        <p class="mt-4 font-display text-xl text-soleil">{t("Audit énergétique et rénovation en Alsace", "Energy audits and renovation in Alsace")}</p>
        <p class="mt-5 max-w-xl text-lg text-white/85">
          {t("Nous repérons où votre logement perd de la chaleur, puis nous classons les travaux par efficacité, aides comprises.", "We identify where your home loses heat, then prioritise improvements by effectiveness, taking available funding into account.")}
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="#contact" class="btn-chaud">{t("Parlons de votre projet", "Let's discuss your project")} <span aria-hidden="true">↗</span></a>
          <a href={`tel:${site.phoneHref}`} class="btn-contour">{site.phone}</a>
        </div>
        <p class="mt-4 text-sm text-white/75">{t("Devis gratuit · Réponse sous 24 h · Sans engagement", "Free quote · Reply within 24 hours · No obligation")}</p>
      </div>
      <div
        class="relative grid overflow-hidden rounded-xl shadow-2xl"
        data-carousel
        role="region"
        aria-label={t("Nos conseils pour une rénovation énergétique réussie", "Our advice for a successful energy renovation")}
        aria-roledescription={t("carrousel", "carousel")}
        tabindex="0"
      >
        {diapositives.map((diapositive, i) => (
          <div
            class:list={["carousel-slide", { "is-active": i === 0 }]}
            data-carousel-slide
            role="group"
            aria-roledescription={t("diapositive", "slide")}
            aria-label={t(`${i + 1} sur ${diapositives.length}`, `${i + 1} of ${diapositives.length}`)}
            aria-hidden={i !== 0 ? "true" : "false"}
          >
            <img
              src={diapositive.image}
              alt={diapositive.alt}
              width="1400"
              height="933"
              loading="eager"
              class="h-[24rem] w-full object-cover md:h-[30rem]"
            />
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-nuit/95 via-nuit/65 to-transparent px-6 pb-8 pt-20 text-white sm:px-8">
              <h2 class="text-2xl font-bold sm:text-3xl">{diapositive.titre}</h2>
              <p class="mt-2 max-w-lg text-sm text-white/85 sm:text-base">{diapositive.texte}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="border-b border-nuit/10 bg-glace">
    <div class="mx-auto grid max-w-6xl gap-5 px-5 py-7 text-sm sm:grid-cols-3">
      {[t("Une étude adaptée à votre logement", "An assessment tailored to your home"), t("Des travaux priorisés et chiffrés", "Prioritised, costed improvements"), t("Un accompagnement sur les aides", "Support with available funding")].map((label) => <p class="flex items-center gap-3 font-semibold"><span aria-hidden="true" class="text-magenta">✓</span>{label}</p>)}
    </div>
  </div>

  <section class="mx-auto max-w-6xl px-5 py-16">
    <p class="eyebrow">{t("À chaque projet, la bonne étude", "The right assessment for every project")}</p>
    <h2 class="mt-3 text-3xl font-bold sm:text-4xl">{t("Comment pouvons-nous vous aider ?", "How can we help you?")}</h2>
    <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {localizedServices.map((s, i) => (
        <a href={href(`/${s.slug}/`)} class="service-card group">
          <div class="mb-6 flex items-center justify-between"><span class="font-display text-sm font-bold text-magenta">{String(i + 1).padStart(2, "0")}</span><span aria-hidden="true" class="text-xl text-brume group-hover:text-magenta">↗</span></div>
          <h3 class="text-xl font-semibold group-hover:underline">{s.nav}</h3>
          <p class="mt-3 text-sm leading-relaxed text-brume">{s.resume}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="bg-glace">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <p class="eyebrow">{t("Simple, de la première question aux travaux", "Straightforward, from first question to renovation")}</p>
      <h2 class="mt-3 text-3xl font-bold">{t("Un parcours clair, à vos côtés.", "A clear path, with support at every step.")}</h2>
      <ol class="mt-8 grid gap-8 md:grid-cols-4">
        {etapes.map((e, i) => (
          <li>
            <span class="font-display text-4xl font-bold text-magenta">{i + 1}</span>
            <h3 class="mt-2 text-lg font-semibold">{e.titre}</h3>
            <p class="mt-1 text-brume">{e.texte}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16">
    <p class="eyebrow">{t("Proches de votre projet", "Local support for your project")}</p>
    <h2 class="mt-3 text-3xl font-bold">{t("Strasbourg et toute l’Alsace.", "Strasbourg and all of Alsace.")}</h2>
    <p class="mt-3 max-w-2xl text-brume">{t(`Basés à ${site.locality}, nous intervenons jusqu’à 100 km autour de Strasbourg.`, `Based in ${site.locality}, we work within 100 km of Strasbourg.`)}</p>
    <ul class="mt-6 flex flex-wrap gap-3">
      {zones.map((z) => (
        <li><a class="inline-block rounded-full border border-nuit/20 px-4 py-2 font-medium hover:border-magenta hover:text-magenta" href={href(`/zones/${z.slug}/`)}>{z.nom}</a></li>
      ))}
    </ul>
  </section>

  <section id="contact" class="bg-glace">
    <div class="mx-auto grid max-w-6xl items-start gap-10 px-5 py-16 lg:grid-cols-2">
      <div>
        <p class="eyebrow">{t("Faisons le premier pas", "Take the first step")}</p>
        <h2 class="mt-3 text-3xl font-bold sm:text-4xl">{t("Votre projet commence par un échange.", "Your project starts with a conversation.")}</h2>
        <p class="mt-4 mb-8 text-brume">{t("Décrivez votre projet en quelques lignes : nous vous répondons sous 24 h.", "Tell us about your project: we will reply within 24 hours.")}</p>
        <ContactMethods />
      </div>
      <div class="contact-card">
        <h3 class="mb-6 text-2xl font-bold">{t("Demandez votre devis gratuit", "Request your free quote")}</h3>
        <ContactForm />
      </div>
    </div>
  </section>
</Layout>

<style>
  .carousel-slide {
    position: relative;
    grid-area: 1 / 1;
    opacity: 0;
    pointer-events: none;
    transition: opacity 700ms ease-in-out;
  }

  .carousel-slide.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-slide {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((carousel) => {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>("[data-carousel-slide]"));
    if (slides.length < 2) return;

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let activeIndex = 0;
    let isHovered = false;
    let hasFocus = false;
    let timer: ReturnType<typeof setInterval> | undefined;

    const showSlide = (index: number) => {
      activeIndex = (index + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        slide.classList.toggle("is-active", i === activeIndex);
        slide.setAttribute("aria-hidden", String(i !== activeIndex));
      });
    };

    const schedule = () => {
      if (timer) clearInterval(timer);
      if (!prefersReducedMotion.matches && !isHovered && !hasFocus && !document.hidden) {
        timer = setInterval(() => showSlide(activeIndex + 1), 4000);
      }
    };

    carousel.addEventListener("mouseenter", () => {
      isHovered = true;
      schedule();
    });
    carousel.addEventListener("mouseleave", () => {
      isHovered = false;
      schedule();
    });
    carousel.addEventListener("focusin", () => {
      hasFocus = true;
      schedule();
    });
    carousel.addEventListener("focusout", (event) => {
      hasFocus = event.relatedTarget instanceof Node && carousel.contains(event.relatedTarget);
      schedule();
    });
    prefersReducedMotion.addEventListener("change", schedule);
    document.addEventListener("visibilitychange", schedule);

    schedule();
  });
</script>
