---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
import { zones } from "../data/zones";
import { localize } from "../i18n";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  jsonLd?: object[];
}
const { title, description, noindex = false, jsonLd = [] } = Astro.props;
const { lang, t, href, frenchPath, englishPath } = localize(Astro.url);
const canonical = new URL(Astro.url.pathname, site.url).href;
const fullTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;

const entreprise = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: site.name,
  url: site.url,
  telephone: site.phoneHref,
  description: t("Bureau d’étude en rénovation énergétique : audit énergétique, rénovation globale, AMO copropriété.", "Energy renovation consultancy: energy audits, whole-home renovation and condominium project support."),
  address: { "@type": "PostalAddress", addressLocality: site.locality, addressRegion: site.region, addressCountry: "FR" },
  areaServed: zones.map((z) => ({ "@type": "City", name: z.nom })),
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={new URL(frenchPath, site.url).href} />
    <link rel="alternate" hreflang="en" href={new URL(englishPath, site.url).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(frenchPath, site.url).href} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#17163a" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === "fr" ? "fr_FR" : "en_GB"} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(entreprise)} />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body class="bg-white font-sans text-nuit antialiased">
    <a href="#contenu" class="sr-only rounded-md bg-white px-4 py-2 font-semibold focus:not-sr-only focus:absolute focus:left-3 focus:top-3 focus:z-50">{t("Aller au contenu", "Skip to content")}</a>
    <Header />
    <main id="contenu"><slot /></main>
    <Footer />
    <div class="mobile-contact">
      <a href={`tel:${site.phoneHref}`} aria-label={`${t("Appeler", "Call us")} ${site.phone}`}>{t("Appeler l’entreprise", "Call us")}</a>
      <a href={href("/contact/")}>{t("Devis gratuit", "Free quote")} <span aria-hidden="true">↗</span></a>
    </div>
  </body>
</html>
