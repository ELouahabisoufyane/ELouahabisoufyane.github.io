---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
import { zones } from "../data/zones";
import { localize } from "../i18n";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  jsonLd?: object[];
}
const { title, description, noindex = false, jsonLd = [] } = Astro.props;
const { lang, t, href, frenchPath, englishPath } = localize(Astro.url);
const canonical = new URL(Astro.url.pathname, site.url).href;
const fullTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;

const entreprise = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: site.name,
  url: site.url,
  telephone: site.phoneHref,
  description: t("Bureau d’étude en rénovation énergétique : audit énergétique, rénovation globale, AMO copropriété.", "Energy renovation consultancy: energy audits, whole-home renovation and condominium project support."),
  address: { "@type": "PostalAddress", addressLocality: site.locality, addressRegion: site.region, addressCountry: "FR" },
  areaServed: zones.map((z) => ({ "@type": "City", name: z.nom })),
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={new URL(frenchPath, site.url).href} />
    <link rel="alternate" hreflang="en" href={new URL(englishPath, site.url).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(frenchPath, site.url).href} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#17163a" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === "fr" ? "fr_FR" : "en_GB"} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(entreprise)} />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body class="bg-white font-sans text-nuit antialiased">
    <a href="#contenu" class="sr-only rounded-md bg-white px-4 py-2 font-semibold focus:not-sr-only focus:absolute focus:left-3 focus:top-3 focus:z-50">{t("Aller au contenu", "Skip to content")}</a>
    <Header />
    <main id="contenu"><slot /></main>
    <Footer />
    <button
      type="button"
      class="back-to-top"
      data-back-to-top
      aria-label={t("Retour en haut de la page", "Back to top")}
      title={t("Retour en haut", "Back to top")}
      hidden
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m6 12 6-6 6 6M12 6v12" />
      </svg>
    </button>
    <div class="mobile-contact">
      <a href={`tel:${site.phoneHref}`} aria-label={`${t("Appeler", "Call us")} ${site.phone}`}>{t("Appeler l’entreprise", "Call us")}</a>
      <a href={href("/contact/")}>{t("Devis gratuit", "Free quote")} <span aria-hidden="true">↗</span></a>
    </div>
  </body>
</html>

<style>
  .back-to-top {
    position: fixed;
    right: 1.25rem;
    bottom: 1.5rem;
    z-index: 45;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--color-nuit);
    border-radius: 50%;
    background: var(--color-nuit);
    color: white;
    box-shadow: 0 4px 20px #17163a30;
    cursor: pointer;
    transition: background-color .2s;
  }

  .back-to-top[hidden] { display: none; }
  .back-to-top:hover { background: var(--color-violet); }

  @media (max-width: 639px) {
    .back-to-top {
      right: 1rem;
      bottom: calc(5.5rem + env(safe-area-inset-bottom));
    }
  }
</style>

<script>
  const backToTop = document.querySelector<HTMLButtonElement>("[data-back-to-top]");
  if (backToTop) {
    const updateVisibility = () => {
      backToTop.hidden = window.scrollY < 400;
    };
    window.addEventListener("scroll", updateVisibility, { passive: true });
    updateVisibility();

    backToTop.addEventListener("click", () => {
      window.scrollTo({
        top: 0,
        behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "instant" : "smooth",
      });
    });
  }
</script>
